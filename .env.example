# Database
DB_HOST=localhost
DB_PORT=5454
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=interview_notes
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Application
APP_NAME=Interview Notes API
APP_VERSION=0.1.0
APP_DESCRIPTION=API for managing technical interview preparation content
HOST=0.0.0.0
PORT=8888
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# CORS values must be valid JSON arrays
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Security: replace both values with long random secrets
SECRET_KEY=replace-with-a-long-random-secret
REFRESH_SECRET_KEY=replace-with-a-different-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_ATTEMPTS=5
LOCK_DURATION_MINUTES=15

# Email / password recovery
# Use a local SMTP sink such as Mailpit during development.
SMTP_SERVER=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASSWORD=dev
SENDER_EMAIL=no-reply@example.com
SENDER_NAME=Dev Interview Notes
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
